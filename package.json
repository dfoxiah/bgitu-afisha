{
  "name": "bgitu-afisha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"try { require('fs').rmSync('.next/dev', { recursive: true, force: true }) } catch (_) {}\"",
    "build": "next build",
    "pretype-check": "node -e \"try { require('fs').rmSync('.next/dev', { recursive: true, force: true }) } catch (_) {}\"",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test:smoke:api": "tsx tests/smoke/api-smoke.ts",
    "test:smoke:e2e": "tsx tests/smoke/e2e-smoke.ts",
    "test:smoke": "npm run test:smoke:api && npm run test:smoke:e2e",
    "test:smoke:local": "tsx tests/smoke/run-local.ts",
    "format": "prettier --write .",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "classnames": "^2.3.2",
    "date-fns": "^2.30.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^18.3.1",
    "autoprefixer": "^10.4.16",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.0",
    "typescript": "5.3.3"
  }
}
