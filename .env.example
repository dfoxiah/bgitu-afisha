# Copy this file to .env.local and fill in real values for local development.

# Database
# For Neon: DATABASE_URL should be the pooled connection string (pgbouncer=true),
# DIRECT_URL should be the direct connection string (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION=""

# OAuth (optional)
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
YANDEX_SCOPE="login:email login:info"
MAX_CLIENT_ID=""
MAX_CLIENT_SECRET=""
MAX_AUTHORIZATION_URL=""
MAX_TOKEN_URL=""
MAX_USERINFO_URL=""
MAX_SCOPE="openid profile email"

# External notification channels (optional)
# VK requires a community/group token with messages permission and user opt-in to community messages.
VK_GROUP_TOKEN=""
VK_API_VERSION="5.199"
# Telegram requires a bot token, bot username and webhook setup.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Email delivery can be connected through a webhook or direct SMTP.
EMAIL_NOTIFICATION_WEBHOOK_URL=""
EMAIL_NOTIFICATION_FROM="no-reply@bgitu.ru"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_SECURE="false"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

# Client polling / realtime tuning (optional)
NEXT_PUBLIC_EVENTS_MIN_REFETCH_MS="5000"
NEXT_PUBLIC_NOTIFICATIONS_POLL_MS="15000"
NEXT_PUBLIC_NOTIFICATIONS_MANUAL_COOLDOWN_MS="5000"
NEXT_PUBLIC_ADMIN_LIVE_INTERVAL_MS="30000"

# Debugging (optional)
NEXTAUTH_DEBUG="false"
DEBUG_MIDDLEWARE="false"
DEBUG_AUTH="false"
DEBUG_EVENTS="false"

# Demo / test toggles (optional)
NEXT_PUBLIC_ENABLE_DEMO="false"
ENABLE_DEV_SETUP_ENDPOINT="false"
DEV_SETUP_TOKEN=""

# Seed (optional)
SEED_RESET="false"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="AdminUser{n}"
ADMIN_SEED_EMAILS="AdminNovaQ7K3Z9X@bgitu.ru,AdminNovaQ7K3Z9Y@bgitu.ru,AdminNovaQ7K3Z9Z@bgitu.ru"
TEACHER_SEED_EMAIL="MainTeacher2026@bgitu.ru"
TEACHER_SEED_PASSWORD=""
STUDENT_SEED_PASSWORD=""
SEED_UPDATE_PASSWORDS="false"
SEED_LOG_PASSWORDS="false"
