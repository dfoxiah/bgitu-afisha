# Copy this file to .env.local and fill in real values for local development.

# Database
# For Neon: DATABASE_URL should be the pooled connection string (pgbouncer=true),
# DIRECT_URL should be the direct connection string (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret"

# OAuth (optional)
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
YANDEX_SCOPE="login:email login:info"
MAX_CLIENT_ID=""
MAX_CLIENT_SECRET=""
MAX_AUTHORIZATION_URL=""
MAX_TOKEN_URL=""
MAX_USERINFO_URL=""
MAX_SCOPE="openid profile email"

# External notification channels (optional)
# VK requires a community/group token with messages permission and user opt-in to community messages.
VK_GROUP_TOKEN=""
VK_API_VERSION="5.199"
# Email/Yandex delivery can be connected through an internal webhook or mail service.
EMAIL_NOTIFICATION_WEBHOOK_URL=""
EMAIL_NOTIFICATION_FROM="no-reply@bgitu.ru"

# Debugging (optional)
NEXTAUTH_DEBUG="false"
DEBUG_MIDDLEWARE="false"
DEBUG_AUTH="false"
DEBUG_EVENTS="false"

# Demo / test toggles (optional)
NEXT_PUBLIC_ENABLE_DEMO="false"

# Seed (optional)
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="AdminUser{n}"
ADMIN_SEED_EMAILS="AdminNovaQ7K3Z9X@bgitu.ru,AdminNovaQ7K3Z9Y@bgitu.ru,AdminNovaQ7K3Z9Z@bgitu.ru"
TEACHER_SEED_EMAIL="MainTeacher2026@bgitu.ru"
TEACHER_SEED_PASSWORD=""
SEED_UPDATE_PASSWORDS="false"
