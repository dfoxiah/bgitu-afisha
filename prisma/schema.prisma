// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  role          Role           @default(STUDENT)
  password      String?
  department    String?
  group         String?
  admissionYear Int?
  groupChangeCount Int         @default(0)
  bio           String?        @db.Text
  profileCompletedAt DateTime?
  notifyNewEvents Boolean       @default(true)
  notifyChanges   Boolean       @default(true)
  notifyNews      Boolean       @default(false)
  notifyInApp     Boolean       @default(true)
  notifyEmail     Boolean       @default(false)
  notifyVk        Boolean       @default(false)
  notificationCategories EventCategory[] @default([])
  vkUserId      String?
  yandexEmail   String?
  privacyConsentAt DateTime?
  privacyConsentVersion String?
  termsConsentAt   DateTime?
  termsConsentVersion   String?
  consentSource String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  accounts          Account[]
  sessions          Session[]
  consents          UserConsent[]
  importJobs        ImportJob[]         @relation("ImportActor")
  newsTemplates     NewsTemplate[]      @relation("NewsTemplateCreator")
  eventsCreated     Event[]             @relation("EventCreator")
  eventsModerated   EventModerator[]
  eventParticipants EventParticipant[]
  notifications     Notification[]
  auditLogs         AuditLog[]          @relation("AuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                String       @id @default(cuid())
  title             String
  category          EventCategory
  date              DateTime
  time              String
  duration          String
  location          String
  description       String       @db.Text
  maxParticipants   Int
  currentParticipants Int        @default(0)
  requiresApproval  Boolean      @default(true)
  isPublic          Boolean      @default(true)
  isPast            Boolean      @default(false)
  removedFromCalendar Boolean    @default(false)
  isNews            Boolean      @default(false)
  images            String[]     // JSON array stored as text
  responsible       String
  contact           String
  
  // Relations
  creatorId         String
  creator           User                @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  moderators        EventModerator[]
  eventParticipants EventParticipant[]
  
  // Report
  report            EventReport?
  
  // Metadata
  createdAt         DateTime     @default(now())
  completedAt       DateTime?
  updatedAt         DateTime     @updatedAt
  
  @@index([date])
  @@index([category])
  @@index([isPast])
  @@index([isPublic])
}

model EventModerator {
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entityType String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model EventParticipant {
  eventId   String
  userId    String
  status    ParticipantStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
}

model EventReport {
  id                String   @id @default(cuid())
  eventId           String   @unique
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status            ReportStatus @default(DRAFT)
  summary           String   @db.Text
  tasks             String[] // JSON array stored as text
  comment           String?  @db.Text
  reportDate        DateTime
  activeParticipants String[] // JSON array stored as text
  images            String[] // JSON array stored as text
  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String           @db.Text
  type      NotificationType
  read      Boolean          @default(false)
  link      String?
  metadata  Json?            // Store additional data as JSON
  createdAt DateTime         @default(now())
  
  @@index([userId, read])
  @@index([createdAt])
}

model UserConsent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  version   String
  source    String
  provider  String?
  ip        String?
  userAgent String?
  acceptedAt DateTime   @default(now())

  @@index([userId, type])
  @@index([acceptedAt])
}

model ImportJob {
  id        String       @id @default(cuid())
  actorId   String?
  actor     User?        @relation("ImportActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      ImportType
  mode      String
  status    ImportStatus
  inputRows Int          @default(0)
  created   Int          @default(0)
  updated   Int          @default(0)
  skipped   Int          @default(0)
  errors    Json?
  warnings  Json?
  fileName  String?
  createdAt DateTime     @default(now())

  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model NewsTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  body        String   @db.Text
  variables   String[] @default([])
  createdById String?
  createdBy   User?    @relation("NewsTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}

enum Role {
  STUDENT
  TEACHER
  MODERATOR
  EDITOR
  ADMIN
}

enum EventCategory {
  CONCERT
  INTERNAL_ACTIVITY
  PUBLIC_EVENT
  COMPETITION
  LECTURE
  MASTERCLASS
  VOLUNTEER
  NEWS
}

enum NotificationType {
  NEW
  CHANGE
  COMPLETE
  EVENT
  SYSTEM
  ACTIVE_PARTICIPANT
  LEADER_ASSIGNED
  ROLE_ASSIGNED
  PARTICIPANT_ADDED
  PARTICIPATION_STATUS_CHANGED
  EVENT_COMPLETED
  REPORT_DRAFT_CREATED
  IMPORT_COMPLETED
  IMPORT_COMPLETED_WITH_ERRORS
  ACCESS_CHANGED
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
}

enum ConsentType {
  PRIVACY
  TERMS
}

enum ImportType {
  USERS
  EVENTS
  NEWS
}

enum ImportStatus {
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}
